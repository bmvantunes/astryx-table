  "reviewedChanges": [
    {
      "source": "migration/table/src/internal/hotkey-adapter.ts",
      "target": "packages/table/src/internal/hotkey-adapter.ts",
      "sha256": "8d447ba7f449a7fa2547c3edaffea62dc57578ed80ac7d83d882973d43037455",
      "sourceSha256": "748cd8ca35c8598866c5389bb9d92b4fecfb089cee7610affc8ac1950a82b653",
      "reviewExempt": false,
      "reason": "Extract the current Window ternary before the document-target condition because stable React Compiler cannot lower the nested ternary. Preserve document identity, SSR and event registration behavior. Requires independent compiler-integration review and existing Browser hotkey regressions; not a mechanical import. Native pointer Shift intent now projects the owning-document MouseEvent modifiers through TanStack parseKeyboardEvent using an undispatched owning-realm KeyboardEvent. This avoids the document-global held-key singleton for iframe clicks, retains detail-zero keyboard exclusion and accompanying modifiers, and adds no listeners or state engine. Public iframe regressions and independent review required. Register Escape on the actual owning document, including iframe documents, with the pinned TanStack cross-realm correction; preserve ownership arbitration and cleanup."
    },
    {
      "source": "migration/table/src/internal/toolbar-instrumentation.ts",
      "target": "packages/table/src/internal/toolbar-instrumentation.ts",
      "sha256": "f25659cea8dbf2114a9058921d10102cdc7bf71379b1d3a04ee6eb51ad71c706",
      "sourceSha256": "a4825a73f333741ba88f5b5385efe0adc82704f5d628ee25bfaba98648c4602b",
      "reviewExempt": false,
      "reason": "Isolate diagnostic listener exceptions so observers cannot interrupt subscriptions or subsequent listeners. Reviewed semantic correction for PR #18 comment 4174121727; not a mechanical import."
    },
    {
      "source": "migration/table/src/internal/client-facet.ts",
      "target": "packages/table/src/internal/client-facet.ts",
      "sha256": "33293205ff3e5e150e4ce0a80013b249424c68107b975f410a1e27b99366e9bb",
      "sourceSha256": "118bb781e92646c25d385051c345f9826a2d0000f649d1a4b3382429c761c53d",
      "reviewExempt": false,
      "reason": "Open-facet incremental exact-value contributions under unchanged query, row identity and cardinality, preserving first-source-occurrence ordering and rebuilding for query/structural changes. Requires independent review and differential/performance validation."
    },
    {
      "source": "migration/table/src/internal/client-row-pipeline.tsx",
      "target": "packages/table/src/internal/client-row-pipeline.tsx",
      "sha256": "d18b031710be349466c491133a04ec137dd61e43f4d89557ac7b7dd79b3e3707",
      "sourceSha256": "bf2cb6573548346b44082ee7880e02fb98dde770a2802512feb44615f7a221b7",
      "reviewExempt": false,
      "reason": "Use committed TanStack row order and current neighbour comparisons to retain unchanged sort projections across value-only publications; membership, identity, invalid-value and ordering changes still reproject. Semantic performance optimization requires independent review, differential tests and production measurement. Own the bounded grouped-input cache using immutable admitted-row tokens and clear it on ungrouping/disposal. Use a shared typed row reader to avoid per-publication row wrappers and closures; standalone derivation retains its original entry point. Opt the canonical immutable Client Adapter into bounded native result reuse proven by exact ordered admission membership and compiled plan; custom or altered semantics keep the original executor. Reconcile retained identity-stable Client cell ranges before publishing raw/grouped projection changes, preserving coherent clipboard identity evidence."
    },
    {
      "source": "migration/table/src/internal/client-grouping.ts",
      "target": "packages/table/src/internal/client-grouping.ts",
      "sha256": "b084acd15898fe82bcd6f97e80c43e3d01bf53fdbd8edbc7d06f4ba7593afbf0",
      "sourceSha256": "75ea1aabc375c5db59bc15f8d0e52a560bd9be054337747e663eb6a21bdf0d17",
      "reviewExempt": false,
      "reason": "Bound prepared built-in grouping inputs to 16,384 value slots, invalidate by exact compiled key/aggregate roles, and preserve custom codec and aggregate execution. Avoid transient presence freezes and repeated primitive key encoding. Semantic optimization requires differential tests, independent review and complete production measurements. Built-in distinct counts use exact primitive Set identity and a separate Missing sentinel; custom counts retain canonical encoding and failure behavior. Use a shared typed row reader to avoid per-publication row wrappers and closures; standalone derivation retains its original entry point. Opt the canonical immutable Client Adapter into bounded native result reuse proven by exact ordered admission membership and compiled plan; custom or altered semantics keep the original executor."
    },
    {
      "source": "migration/table/src/internal/compile-columns.ts",
      "target": "packages/table/src/internal/compile-columns.ts",
      "sha256": "23e041c5683bd85c055dcf12cc61caf6c1599271b13fb58c8a5e1642c0611a7e",
      "sourceSha256": "b7e4653845bc6bf019a5c93a2d45a7597626dc3f10fc536e3bd07137a631b1c2",
      "reviewExempt": false,
      "reason": "Privately certify exact frozen compiler-owned native columns for bounded native group-result reuse. Cloned or custom semantics cannot acquire this proof. Requires semantic review and native/custom differential tests."
    },
